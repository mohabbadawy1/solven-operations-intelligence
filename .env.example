# Groq API credentials used by ai/report_generator.py
GROQ_API_KEY=your-api-key-here

# Model to use for executive report generation
GROQ_MODEL=openai/gpt-oss-120b

# Optional: request timeout, retry count, sampling temperature, and max
# output tokens for report generation. Sensible defaults are used if unset.
# GROQ_TIMEOUT_SECONDS=60
# GROQ_MAX_RETRIES=2
# GROQ_TEMPERATURE=0.3
# GROQ_MAX_OUTPUT_TOKENS=3200

# openai/gpt-oss-120b is a reasoning model -- its internal chain-of-
# thought counts against max_output_tokens (and this platform's Groq
# tier's 8,000 tokens-per-minute limit) even though it never appears in
# the response. "low" keeps that overhead small enough for the full
# narrative response to fit comfortably in the budget above; raise it
# ("medium"/"high") only if you also raise GROQ_MAX_OUTPUT_TOKENS and
# have TPM headroom to spare (see ai/report_generator.py's
# DEFAULT_REASONING_EFFORT for the measurements behind this default).
# GROQ_REASONING_EFFORT=low
