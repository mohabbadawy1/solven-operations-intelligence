# Groq API credentials used by ai/report_generator.py
GROQ_API_KEY=your-api-key-here

# Model to use for executive report generation
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: request timeout, retry count, sampling temperature, and max
# output tokens for report generation. Sensible defaults are used if unset.
# GROQ_TIMEOUT_SECONDS=60
# GROQ_MAX_RETRIES=2
# GROQ_TEMPERATURE=0.3
# GROQ_MAX_OUTPUT_TOKENS=4000
