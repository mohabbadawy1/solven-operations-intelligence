# OpenAI API credentials used by ai/report_generator.py
OPENAI_API_KEY=your-api-key-here

# Model to use for executive report generation
OPENAI_MODEL=gpt-4o-mini

# Optional: OpenAI organization ID, if your account belongs to more than one
# OPENAI_ORG_ID=

# Optional: request timeout, retry count, sampling temperature, and max
# output tokens for report generation. Sensible defaults are used if unset.
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_RETRIES=2
# OPENAI_TEMPERATURE=0.3
# OPENAI_MAX_OUTPUT_TOKENS=4000
